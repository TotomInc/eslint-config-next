{
  "name": "@totominc/eslint-config-next",
  "type": "module",
  "version": "3.0.0",
  "description": "Strict, type-safe ESLint config for React, Next.js, Vue and TypeScript projects, built on @antfu/eslint-config.",
  "author": "Thomas Cazade <cazade.thomas@gmail.com>",
  "license": "GPL-3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TotomInc/eslint-config-next.git"
  },
  "keywords": [
    "eslint",
    "eslint-config",
    "antfu",
    "typescript",
    "react",
    "nextjs",
    "vue",
    "tailwindcss",
    "prettier"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup index.ts --format esm,cjs --clean --dts",
    "dev": "tsup index.ts --format esm,cjs --watch",
    "debug-config": "npx @eslint/config-inspector --open false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "eslint": "^10.2.0",
    "eslint-plugin-turbo": "^2.11.7"
  },
  "peerDependenciesMeta": {
    "eslint-plugin-turbo": {
      "optional": true
    }
  },
  "dependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@eslint-react/eslint-plugin": "5.30.1",
    "@next/eslint-plugin-next": "16.4.6",
    "@typescript-eslint/utils": "8.72.2",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-vuejs-accessibility": "2.6.3",
    "prettier": "3.10.0",
    "tailwindcss": "4.3.5"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.72.2",
    "@typescript-eslint/rule-tester": "8.72.2",
    "eslint": "10.14.0",
    "eslint-plugin-turbo": "2.11.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsup": "9.0.0",
    "turbo": "2.11.10",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
