{
  "name": "@totominc/eslint-config-next",
  "type": "module",
  "version": "3.0.0",
  "description": "Enhanced ESLint config for Next.js projects.",
  "author": "Thomas Cazade <cazade.thomas@gmail.com>",
  "license": "GPL-3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TotomInc/eslint-config-next.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup index.ts --format esm,cjs --clean --dts",
    "dev": "tsup index.ts --format esm,cjs --watch",
    "debug-config": "npx @eslint/config-inspector --open false",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run"
  },
  "peerDependencies": {
    "eslint": "^10.2.0"
  },
  "dependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@eslint-react/eslint-plugin": "5.18.2",
    "@next/eslint-plugin-next": "16.3.0",
    "@typescript-eslint/utils": "8.67.0",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react-refresh": "0.5.3",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript-eslint/parser": "8.67.0",
    "@typescript-eslint/rule-tester": "8.67.0",
    "eslint": "10.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
